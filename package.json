{
  "name": "raster-gpu-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:component && npm run test:postgres && npm run test:render",
    "test:component": "vitest run --config vitest.config.ts tests/sourcing-desk.component.test.tsx",
    "test:u2": "node --experimental-strip-types --test tests/collector-contract.test.mjs tests/collector-cli.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/collector-contract.test.mjs tests/collector-cli.test.mjs tests/dynacore-adapter.test.mjs tests/infinity-adapter.test.mjs tests/normalization.test.mjs tests/ingestion.test.mjs tests/refresh-client.test.mjs tests/refresh-route.test.mjs tests/replay.test.mjs tests/workflow-sign-refresh.test.mjs tests/persistence.test.mjs tests/evidence-sanitizer.test.mjs tests/catalog-repository.test.mjs tests/market-registry.test.mjs tests/market-pack.test.mjs tests/healing-evidence.test.mjs tests/healing-policy.test.mjs tests/postgres-boundary.test.mjs tests/storage-health-route.test.mjs",
    "test:render": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate:collector": "node --experimental-strip-types scripts/validate-collector-output.ts",
    "collect": "node --experimental-strip-types scripts/collect.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-postgres-migration.mjs",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "test:postgres": "node --experimental-strip-types --test tests/postgres-*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@brightdata/cli": "0.3.5",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260821.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "happy-dom": "^20.11.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
