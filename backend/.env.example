# Use a PostgreSQL URL in production. SQLite is suitable for local evaluation.
DATABASE_URL=sqlite:///./hackradar.db

# Load these from Keychain or the deployment secret store; never commit values.
BRIGHTDATA_API_KEY=
OPENAI_API_KEY=
OPERATOR_TOKEN=

AUTO_HEAL_ENABLED=true
COLLECTOR_CLI_TIMEOUT_SECONDS=900
ALLOWED_ORIGINS=https://abhijitmohanty.com,http://localhost:3000
