{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "raster-gpu-market",
	"account_id": "cd3f052ce4665d971cb5c2a73baf214e",
	"compatibility_date": "2026-08-21",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"workers_dev": true,
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "fd5e0bb46b044a1d8b8c4c5ace2a9015"
		}
	]
}
