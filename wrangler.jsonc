{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raster-gpu-market",
  "account_id": "cd3f052ce4665d971cb5c2a73baf214e",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "abhijitmohanty.com/scrapper*",
      "zone_name": "abhijitmohanty.com"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raster-gpu-market",
      "database_id": "517c7bd4-4e28-4b58-89e7-5869d17d92e9",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
